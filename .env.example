# RCY-RPI — environment variables template
# Copy to .env and fill in. NEVER commit the real .env.
# On Cloudflare Pages: NEXT_PUBLIC_* are baked at build time (public by
# design); the rest are set as runtime env vars/secrets in the Pages project.

# --- Supabase (project: frnxmgvvwdhoiieesxmx) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, NEVER expose

# --- Session signing (random 32-byte hex) ---
SESSION_SECRET=your-random-hex-string

# --- Supabase Management API (optional; live gateway-secret reads) ---
SUPABASE_ACCESS_TOKEN=your-supabase-pat
SUPABASE_PROJECT_REF=your-project-ref

# --- Payment gateway (PipraPay) ---
# Priority: env -> app_config table -> Supabase Secrets Manager.
PAYMENT_BASE_URL=https://pay.invokeil.cfd/api
PAYMENT_RUSER_API=your-ruser-api-key
PAYMENT_ADMIN_API=your-admin-api-key

# --- SMTP for reset emails (optional; edge uses on-screen link instead) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RCY RPI <no-reply@example.org>"
